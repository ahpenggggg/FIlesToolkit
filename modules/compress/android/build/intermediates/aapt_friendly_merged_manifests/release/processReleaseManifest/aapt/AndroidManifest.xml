<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.filetoolkit.compress" >

    <uses-sdk android:minSdkVersion="30" />
    <!-- Compressing can take a long time: a foreground service with a progress notification keeps it running. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="expo.modules.filetoolkit.compress.CompressService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>

</manifest>