<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Leftovers of removed apps: telling an uninstalled app from a hidden one needs to see every installed app. -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
  <application>
    <!-- Opens a file in another app so it can be checked before it's cleaned. -->
    <provider
      android:name="expo.modules.filetoolkit.cleaner.CleanerFileProvider"
      android:authorities="${applicationId}.cleaner.files"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/cleaner_paths" />
    </provider>
  </application>
</manifest>
